{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "composite": true, "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo", "skipLibCheck": true, "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["electron.vite.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"]
}

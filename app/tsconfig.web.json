{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "composite": true, "tsBuildInfoFile": "./node_modules/.cache/tsconfig.web.tsbuildinfo", "skipLibCheck": true,
    "types": ["vite/client"], "esModuleInterop": true
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts"]
}
